        <mxCell id="box-1-head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;" value="[ ! ] MENSAJE DE VALIDACIÓN (ALERT)" vertex="1">
          <mxGeometry x="90" y="110" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="box-1-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" value="Texto de alerta: 'Por favor, ingrese un peso válido en gramos (1 a 500 g)'.&#xa;• Se blanquea el valor del campo (input.value = '')&#xa;• Se devuelve el foco automáticamente (input.focus())" vertex="1">
          <mxGeometry x="90" y="150" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-1-btn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;" value="ACEPTAR / CORREGIR" vertex="1">
          <mxGeometry x="450" y="210" width="160" height="35" as="geometry" />
        </mxCell>

        <!-- Modal 2: Confirmación Carrito -->
        <mxCell id="box-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry x="70" y="280" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="box-2-head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;" value="[ ? ] DIÁLOGO DE CONFIRMACIÓN (CONFIRM)" vertex="1">
          <mxGeometry x="90" y="300" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="box-2-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" value="Texto: '¿Está seguro de que desea vaciar su carrito de compras?'&#xa;• Elimina los datos guardados en localStorage.&#xa;• Botón de cancelar para evitar pérdidas accidentales." vertex="1">
          <mxGeometry x="90" y="340" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="box-2-btn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" value="CANCELAR" vertex="1">
